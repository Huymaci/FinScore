# Copy to .env and fill in. Never commit .env (see .gitignore).
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# Password characters that are special in a URL must be percent-encoded.
# '#' becomes %23, '@' becomes %40, ':' becomes %3A, '/' becomes %2F.
DATABASE_URL=mysql+pymysql://smartfinance:replace-me@127.0.0.1:3306/smartfinance?charset=utf8mb4

ADMIN_EMAIL=admin@smartfinance.local
ADMIN_PASSWORD=replace-with-a-strong-password

# false for localhost over HTTP, true behind an HTTPS reverse proxy.
# This flag also controls the Secure attribute on the session cookie: set it to
# true while serving plain HTTP and the browser will refuse to return the
# cookie, which makes login impossible.
HTTPS_ENABLED=false

# Where Flask-Limiter stores its counters. memory:// is per-process and fine for
# a single-process dev server; with more than one worker (gunicorn -w N) use a
# shared store, e.g. redis://127.0.0.1:6379/0, or the auth rate limits are not
# actually enforced across workers.
RATELIMIT_STORAGE_URI=memory://
